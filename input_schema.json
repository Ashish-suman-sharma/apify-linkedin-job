{
  "title": "LinkedIn Jobs Full Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchUrl": {
      "title": "LinkedIn Jobs search URL",
      "type": "string",
      "description": "Paste a LinkedIn jobs URL after applying filters manually.",
      "editor": "textfield",
      "prefill": "https://www.linkedin.com/jobs/search/?keywords=frontend&location=London"
    },
    "maxResults": {
      "title": "Maximum results",
      "type": "integer",
      "description": "How many jobs to scrape (e.g., 100, 500, 1000)",
      "default": 100,
      "minimum": 1,
      "editor": "number"
    }
  },
  "required": [
    "searchUrl"
  ]
}
